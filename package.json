{
  "name": "hyperweaver-server",
  "version": "0.9.9",
  "description": "Hyperweaver Server - Node control plane that serves the STARTcloud UI, authenticates users, and proxies/aggregates host agents",
  "startcloudUiVersion": "0.57.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "generate-docs": "node scripts/generate-docs.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format"
  },
  "keywords": [
    "hyperweaver",
    "bhyve",
    "nodejs"
  ],
  "author": "Makr91",
  "license": "GPL-3.0",
  "dependencies": {
    "@sequelize/core": "^7.0.0-alpha.46",
    "@sequelize/mariadb": "^7.0.0-alpha.46",
    "@sequelize/mysql": "^7.0.0-alpha.46",
    "@sequelize/postgres": "^7.0.0-alpha.46",
    "@sequelize/sqlite3": "^7.0.0-alpha.46",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "i18n": "^0.15.4",
    "jose": "^6.2.12",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.1.7",
    "nodemon": "^3.1.14",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.12.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.1",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "tar": "^7.4.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  }
}
